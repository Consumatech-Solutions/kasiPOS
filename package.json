{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "next dev -p 9002",
    "dev:turbo": "next dev -p 9002 --turbo",
    "dev:webpack": "next dev -p 9002",
    "dev:fresh": "npm run clean && next dev -p 9002",
    "clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "cypress run",
    "coverage": "vitest run --coverage",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test dev http://localhost:9002 cy:run"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ]
  },
  "dependencies": {
